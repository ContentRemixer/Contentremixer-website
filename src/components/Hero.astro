---
import { LINKS } from '../lib/site';
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="copy">
      <p class="eyebrow">Agentic content remixing for DevRel</p>
      <h1>
        Create once.<br />
        <span class="gradient-text">Publish everywhere.</span>
      </h1>
      <p class="lede">
        Drop a talk, a blog, or a livestream into the <strong>Crate</strong>. ContentRemixer's
        agent studies your voice, remixes the source into every format you need, and opens a
        pull request — cleared, on-brand, ready to merge.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={LINKS.gettingStarted} rel="noopener">
          Get started
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn-ghost" href="#how-it-works">See how it works</a>
      </div>
      <ul class="trust">
        <li>Sample clearance on every PR</li>
        <li>Your voice, learned from your Crate</li>
        <li>Self-hosted agent pipeline</li>
      </ul>
    </div>

    <!-- The crossfader console: the brand's product-as-metaphor, animated. -->
    <div class="deck-wrap">
      <div class="deck" role="img" aria-label="The Booth: one source crossfading into four published formats">
        <div class="deck-head">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="deck-title">the booth</span>
        </div>

        <div class="lane source">
          <span class="lane-label">Source · the Crate</span>
          <div class="chip chip-source">
            <span class="wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
            Observability 101 — conference talk
          </div>
        </div>

        <div class="fader">
          <div class="track"><span class="fill"></span></div>
          <div class="knob" aria-hidden="true"></div>
          <div class="ticks" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span>
          </div>
        </div>

        <div class="lane outputs">
          <span class="lane-label">Outputs · the Mix</span>
          <div class="chips">
            <span class="chip out o1">Blog post</span>
            <span class="chip out o2">LinkedIn</span>
            <span class="chip out o3">YouTube Short</span>
            <span class="chip out o4">Weekly Remix</span>
          </div>
        </div>
      </div>
      <div class="deck-glow" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(48px, 7vw, 92px);
    padding-bottom: clamp(56px, 8vw, 110px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  h1 {
    font-size: clamp(2.6rem, 5.4vw, 4.3rem);
    font-weight: 700;
    margin-bottom: 22px;
  }
  .lede {
    font-size: clamp(1.05rem, 1.5vw, 1.22rem);
    color: var(--text-dim);
    max-width: 34ch;
  }
  .lede strong {
    color: var(--white);
    font-weight: 600;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }
  .trust {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    list-style: none;
    padding: 0;
    margin: 30px 0 0;
    font-size: 0.9rem;
    color: var(--text-mute);
  }
  .trust li {
    position: relative;
    padding-left: 18px;
  }
  .trust li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--fade);
  }

  /* ---- the deck ---- */
  .deck-wrap {
    position: relative;
  }
  .deck {
    position: relative;
    z-index: 2;
    background: var(--tile);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--r-lg);
    padding: 22px 22px 26px;
    box-shadow: 0 40px 90px -40px rgba(0, 0, 0, 0.9);
  }
  .deck-glow {
    position: absolute;
    inset: 8% 6%;
    z-index: 1;
    background: var(--fade);
    filter: blur(60px);
    opacity: 0.4;
    border-radius: var(--r-lg);
  }
  .deck-head {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 20px;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--track-base);
  }
  .deck-title {
    margin-left: auto;
    font-family: var(--font-head);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .lane-label {
    display: block;
    font-family: var(--font-head);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lavender);
    margin-bottom: 10px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: 0.9rem;
    padding: 9px 14px;
    border-radius: var(--r-pill);
    border: 1px solid var(--hairline-strong);
    background: color-mix(in srgb, var(--white) 5%, transparent);
    color: var(--text-dim);
  }
  .chip-source {
    background: color-mix(in srgb, var(--violet) 18%, transparent);
    border-color: color-mix(in srgb, var(--lavender) 45%, transparent);
    color: var(--white);
  }
  .wave {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
  }
  .wave i {
    width: 3px;
    border-radius: 2px;
    background: var(--lavender);
    animation: eq 0.9s ease-in-out infinite;
  }
  .wave i:nth-child(1) { height: 40%; animation-delay: 0s; }
  .wave i:nth-child(2) { height: 90%; animation-delay: 0.12s; }
  .wave i:nth-child(3) { height: 60%; animation-delay: 0.24s; }
  .wave i:nth-child(4) { height: 100%; animation-delay: 0.36s; }
  .wave i:nth-child(5) { height: 50%; animation-delay: 0.48s; }
  @keyframes eq {
    0%, 100% { transform: scaleY(0.5); }
    50% { transform: scaleY(1); }
  }

  /* ---- fader ---- */
  .fader {
    position: relative;
    margin: 26px 4px;
    height: 44px;
  }
  .track {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 10px;
    transform: translateY(-50%);
    border-radius: var(--r-pill);
    background: var(--track-base);
    overflow: hidden;
  }
  .fill {
    position: absolute;
    inset: 0;
    background: var(--fade);
    transform-origin: left center;
    animation: fill 7s ease-in-out infinite;
  }
  @keyframes fill {
    0%, 100% { transform: scaleX(0.14); }
    50% { transform: scaleX(1); }
  }
  .knob {
    position: absolute;
    top: 50%;
    left: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ffffff, #e8e2ff 70%);
    border: 2px solid color-mix(in srgb, var(--magenta) 60%, white);
    transform: translate(-50%, -50%);
    box-shadow: 0 6px 18px -4px color-mix(in srgb, var(--magenta) 80%, transparent);
    animation: slide 7s ease-in-out infinite;
  }
  @keyframes slide {
    0%, 100% { left: 14%; }
    50% { left: 100%; }
  }
  .ticks {
    position: absolute;
    inset: auto 0 -2px;
    display: flex;
    justify-content: space-between;
    padding-inline: 2px;
  }
  .ticks span {
    width: 2px;
    height: 7px;
    border-radius: 2px;
    background: var(--hairline-strong);
  }

  /* ---- outputs ---- */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }
  .out {
    position: relative;
    animation: lightup 7s ease-in-out infinite;
  }
  .o1 { animation-delay: 0.2s; }
  .o2 { animation-delay: 1.1s; }
  .o3 { animation-delay: 2s; }
  .o4 { animation-delay: 2.9s; }
  @keyframes lightup {
    0%, 42%, 100% {
      border-color: var(--hairline-strong);
      color: var(--text-dim);
      background: color-mix(in srgb, var(--white) 5%, transparent);
      box-shadow: none;
    }
    50%, 70% {
      border-color: color-mix(in srgb, var(--orange) 70%, transparent);
      color: var(--white);
      background: color-mix(in srgb, var(--orange) 16%, transparent);
      box-shadow: 0 6px 20px -8px color-mix(in srgb, var(--orange) 80%, transparent);
    }
  }

  @media (max-width: 920px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .lede {
      max-width: 52ch;
    }
    .deck-wrap {
      max-width: 520px;
    }
  }
</style>
