---
import { NAV, LINKS } from '../lib/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href={base} aria-label="ContentRemixer home">
      <img src={`${base}brand/svg/logo_mono_white.svg`} alt="ContentRemixer" height="30" width="210" />
    </a>

    <nav class="links" aria-label="Primary">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="actions">
      <a class="gh" href={LINKS.repo} aria-label="ContentRemixer on GitHub" rel="noopener">
        <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
      </a>
      <a class="btn btn-primary cta" href={LINKS.gettingStarted} rel="noopener">Get started</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(140%) blur(12px);
    background: color-mix(in srgb, var(--ink) 72%, transparent);
    border-bottom: 1px solid var(--hairline);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 68px;
  }
  .brand {
    display: flex;
    align-items: center;
    margin-right: auto;
  }
  .brand img {
    height: 30px;
    width: auto;
  }
  .links {
    display: flex;
    gap: 28px;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: 0.95rem;
  }
  .links a {
    color: var(--text-dim);
    transition: color 0.16s ease;
  }
  .links a:hover {
    color: var(--white);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .gh {
    color: var(--text-dim);
    display: inline-flex;
    transition: color 0.16s ease;
  }
  .gh:hover {
    color: var(--white);
  }
  .cta {
    padding: 9px 18px;
    font-size: 0.92rem;
  }
  @media (max-width: 860px) {
    .links {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .cta {
      display: none;
    }
  }
</style>
