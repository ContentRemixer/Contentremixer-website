---
const steps = [
  {
    n: '01',
    title: 'Fill the Crate',
    body: 'Add reference content — talks, blogs, livestreams, podcasts — one folder per piece with a meta.yaml. Crate digging is the scraper finding your gems.',
  },
  {
    n: '02',
    title: 'Request a Remix',
    body: 'Open a Recycle request issue and pick the target formats with recycle:* labels. Blog post, LinkedIn, YouTube Short — whatever the week needs.',
  },
  {
    n: '03',
    title: 'The agent mixes',
    body: 'Analyzer reads the source, the Writer drafts each format against its style guide, and Mastering scrubs it for brand voice and sample clearance.',
  },
  {
    n: '04',
    title: 'Review & Drop',
    body: 'A pull request lands with the mix and its source attribution. Review, merge, and let the Publishing Hub suggest the channel and the timing.',
  },
];
---

<section id="how-it-works" class="section how">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">How it works</p>
      <h2>From one source to the whole set list.</h2>
      <p class="sub">
        ContentRemixer runs as an agent on your repo. You feed it references and ask for formats;
        it hands you reviewable pull requests.
      </p>
    </header>

    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="step card reveal" style={`transition-delay:${i * 90}ms`}>
            <span class="num">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .head {
    max-width: 56ch;
    margin-bottom: 48px;
  }
  .head h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.9rem);
  }
  .sub {
    margin-top: 16px;
    color: var(--text-dim);
    font-size: 1.08rem;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    counter-reset: none;
  }
  .step {
    padding: 26px 22px 28px;
    position: relative;
    overflow: hidden;
  }
  .step::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--fade);
    opacity: 0.85;
  }
  .num {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    color: var(--lavender);
  }
  .step h3 {
    font-size: 1.22rem;
    margin: 12px 0 10px;
  }
  .step p {
    color: var(--text-dim);
    font-size: 0.97rem;
  }
  @media (max-width: 920px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 540px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
